{
  // Ambiente do Codespaces: Node para o frontend (Vite) e Python para o backend (Flask).
  "name": "Chronos",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "postCreateCommand": "npm install && python -m venv .venv && .venv/bin/pip install -r requirements.txt",
  "forwardPorts": [5173, 5000],
  "portsAttributes": {
    "5173": { "label": "Chronos (frontend)", "onAutoForward": "openBrowser" },
    "5000": { "label": "Chronos (API Flask)" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": { "python.defaultInterpreterPath": ".venv/bin/python" }
    }
  }
}
