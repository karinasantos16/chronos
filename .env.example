# Login com Microsoft (Entra ID)
# 1. Copie este arquivo para .env.local (ele não vai para o GitHub).
# 2. Preencha com os valores do registro do app no Entra ID.
# 3. Reinicie o "npm run dev".
# Sem estes valores, o Chronos usa o login simulado.

# "ID do aplicativo (cliente)" / Application (client) ID
VITE_AZURE_CLIENT_ID=

# "ID do diretório (locatário)" / Directory (tenant) ID da FPFtech
VITE_AZURE_TENANT_ID=

# Opcional: endereço da API, se ela não estiver no mesmo endereço do app
# (o padrão é <endereço do app>/api/). Ex.: https://chronos.fpf.br/api/
# VITE_API_URL=

# Opcional: só preencha se a página-ponte não ficar em <endereço do app>/auth/callback
# VITE_AZURE_REDIRECT_URI=
